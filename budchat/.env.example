# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://budchat:budchat@localhost:5432/budchat?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
# Обязательно сгенерируйте свой: openssl rand -base64 32
# С этим шаблонным значением приложение не запустится в production.
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-string"

# App
PORT=3000
NODE_ENV=development

# ── HTTPS в продакшне (docker-compose.prod.yml) ──────────────────────────
# Домен должен уже указывать A-записью на этот сервер — Caddy сам получит
# сертификат Let's Encrypt. Без HTTPS браузер блокирует геолокацию, push и
# офлайн-режим, а сессии остаются без защищённой cookie.
APP_DOMAIN=""
ACME_EMAIL=""

# Where uploaded photos/files are stored on disk (served from /uploads)
UPLOAD_DIR="./public/uploads"

# Web Push (chat/task notifications). Generate your own pair with:
#   npx web-push generate-vapid-keys
# Leave unset to disable push notifications — everything else still works.
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@example.com"

# SMTP для писем (восстановление пароля, приглашения на объект).
# Без этих переменных письма не отправляются, а их содержимое печатается
# в консоль сервера — этого достаточно для локальной разработки.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="BudChat <no-reply@example.com>"

# ── Отслеживание ошибок (Sentry) ──────────────────────────────────────────
# Пока переменная пустая, Sentry вообще не запускается: приложение работает
# ровно так же, никуда ничего не отправляется.
#
# Чтобы включить: sentry.io → бесплатный аккаунт → создать проект (Next.js) →
# скопировать DSN (это публичный адрес вида https://xxxx@oNNN.ingest.sentry.io/NNN).
# В docker compose одной этой строки хватает и для сервера, и для браузера.
SENTRY_DSN=""

# Как подписывать ошибки: production / staging / development.
SENTRY_ENVIRONMENT="development"

# Доля запросов для замеров скорости (0 — выключено). Трассировки съедают
# бесплатный лимит намного быстрее ошибок, поэтому по умолчанию 0.
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE="0"

# Необязательно: загрузка source maps, чтобы в стектрейсах были нормальные
# имена файлов и строк вместо минифицированных. Токен создаётся в Sentry:
# Settings → Auth Tokens (право project:releases).
SENTRY_ORG=""
SENTRY_PROJECT=""
SENTRY_AUTH_TOKEN=""
