# PostgreSQL connection used by Prisma
DATABASE_URL="postgresql://budchat:budchat@localhost:5432/budchat?schema=public"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-string"

# App
PORT=3000
NODE_ENV=development

# Where uploaded photos/files are stored on disk (served from /uploads)
UPLOAD_DIR="./public/uploads"
