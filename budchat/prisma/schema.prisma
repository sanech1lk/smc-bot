// BudChat — Prisma schema
// Messenger for construction crews: everything (chat, photos, tasks, estimate)
// is scoped to a Project and its Stages, not to calendar dates.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum ProjectRole {
  ADMIN // full control: manage members, stages, estimate
  WORKER // crew member: chat, photos, tasks
  CLIENT // customer: read + sign-off, limited write
}

enum ProjectStatus {
  ACTIVE
  PAUSED
  DONE
  CANCELLED
}

// Drives the gray / yellow / green / red status dot on stage cards
enum StageStatus {
  NOT_STARTED // gray
  IN_PROGRESS // yellow
  DONE // green
  PROBLEM // red
}

enum MessageType {
  TEXT
  PHOTO
  FILE
  SYSTEM
}

enum PhotoTag {
  BEFORE
  AFTER
  PROBLEM
  CHECKED
}

enum TaskStatus {
  NEW
  IN_PROGRESS
  REVIEW
  DONE
}

enum PinStatus {
  OPEN
  RESOLVED
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum ChangeOrderStatus {
  PENDING // waiting for the customer's decision
  APPROVED
  REJECTED
}

enum PunchStatus {
  OPEN
  IN_PROGRESS
  FIXED // contractor says it's done
  VERIFIED // customer confirmed
}

enum DocumentCategory {
  CONTRACT
  DRAWING
  CERTIFICATE
  INVOICE
  OTHER
}

// ---------------------------------------------------------------------------
// Core models
// ---------------------------------------------------------------------------

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  phone        String?
  passwordHash String
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships      ProjectMember[]
  messages         Message[]
  uploadedPhotos   Photo[]
  assignedTasks    Task[]            @relation("TaskAssignee")
  createdTasks     Task[]            @relation("TaskCreator")
  estimateEdits    EstimateHistory[]
  signatures       Signature[]
  pushSubscriptions PushSubscription[]
  planPins         PlanPin[]
  resetTokens      PasswordResetToken[]
  sentInvitations  Invitation[]      @relation("InvitationInviter")
  shifts           Shift[]
  dailyLogs        DailyLog[]
  createdChangeOrders ChangeOrder[]  @relation("ChangeOrderAuthor")
  decidedChangeOrders ChangeOrder[]  @relation("ChangeOrderDecider")
  createdPunchItems   PunchItem[]    @relation("PunchAuthor")
  assignedPunchItems  PunchItem[]    @relation("PunchAssignee")
  uploadedDocuments   Document[]

  @@map("users")
}

// Single-use, short-lived token emailed to a user who forgot their password.
// Only the hash is stored, so a leaked database can't be used to reset accounts.
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("password_reset_tokens")
}

// Lets an admin add someone to a project before that person has even
// registered. With an email set, the membership is created automatically
// when that address signs up; with email null it is a shareable link/QR
// code that any signed-in user can redeem on site.
model Invitation {
  id          String           @id @default(cuid())
  projectId   String
  email       String?
  role        ProjectRole      @default(WORKER)
  status      InvitationStatus @default(PENDING)
  tokenHash   String           @unique
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime         @default(now())

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  invitedBy User    @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: Cascade)

  @@index([email, status])
  @@index([projectId])
  @@map("invitations")
}

// A browser's Web Push subscription for a given user, used to deliver
// notifications (new messages, task assignments) when the app is closed.
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  address     String
  status      ProjectStatus @default(ACTIVE)
  coverColor  String?
  // ISO-4217 code driving how estimate amounts are formatted app-wide.
  currency    String        @default("RUB")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members      ProjectMember[]
  stages       Stage[]
  visits       Visit[]
  plans        Plan[]
  invitations  Invitation[]
  shifts       Shift[]
  dailyLogs    DailyLog[]
  changeOrders ChangeOrder[]
  punchItems   PunchItem[]
  materials    Material[]
  documents    Document[]

  @@map("projects")
}

// An uploaded floor plan / drawing that crew members can drop location pins on
model Plan {
  id        String   @id @default(cuid())
  projectId String
  name      String
  url       String
  createdAt DateTime @default(now())

  project Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  pins    PlanPin[]

  @@index([projectId])
  @@map("plans")
}

// A pin dropped on a Plan at relative (x, y) coordinates (0..1), marking an
// issue, a photo location, or a note tied to a spot on the drawing.
model PlanPin {
  id          String    @id @default(cuid())
  planId      String
  x           Float
  y           Float
  title       String
  description String?
  status      PinStatus @default(OPEN)
  stageId     String?
  photoId     String?
  createdById String
  createdAt   DateTime  @default(now())

  plan      Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  stage     Stage? @relation(fields: [stageId], references: [id], onDelete: SetNull)
  photo     Photo? @relation(fields: [photoId], references: [id], onDelete: SetNull)
  createdBy User   @relation(fields: [createdById], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_pins")
}

model ProjectMember {
  id        String      @id @default(cuid())
  projectId String
  userId    String
  role      ProjectRole @default(WORKER)
  createdAt DateTime    @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@map("project_members")
}

model Stage {
  id        String      @id @default(cuid())
  projectId String
  name      String
  order     Int
  status    StageStatus @default(NOT_STARTED)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  project        Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages       Message[]
  photos         Photo[]
  tasks          Task[]
  estimateItems  Estimate[]
  checklistItems ChecklistItem[]
  signatures     Signature[]
  visits         Visit[]
  planPins       PlanPin[]
  shifts         Shift[]
  changeOrders   ChangeOrder[]
  punchItems     PunchItem[]
  materials      Material[]

  @@unique([projectId, order])
  @@map("stages")
}

model Message {
  id        String      @id @default(cuid())
  stageId   String
  senderId  String
  content   String
  type      MessageType @default(TEXT)
  fileUrl   String?
  createdAt DateTime    @default(now())

  stage  Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([stageId, createdAt])
  @@map("messages")
}

model Photo {
  id           String   @id @default(cuid())
  stageId      String
  uploadedById String
  url          String
  tag          PhotoTag @default(BEFORE)
  description  String?
  // Geolocation captured at shoot time (also burned into the image itself
  // as a visible stamp) — lets a photo double as tamper-evident site proof.
  lat          Float?
  lng          Float?
  accuracy     Float?
  createdAt    DateTime @default(now())

  // Freehand markup drawn over the photo, stored as normalised JSON strokes
  // so it stays crisp at any display size and the original file is untouched.
  annotations String? @db.Text

  stage      Stage       @relation(fields: [stageId], references: [id], onDelete: Cascade)
  uploadedBy User        @relation(fields: [uploadedById], references: [id], onDelete: Cascade)
  planPins   PlanPin[]
  punchItems PunchItem[]

  @@index([stageId, tag])
  @@map("photos")
}

model Task {
  id          String     @id @default(cuid())
  stageId     String
  title       String
  description String?
  assigneeId  String?
  createdById String
  deadline    DateTime?
  status      TaskStatus @default(NEW)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  stage    Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  assignee User? @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  creator  User  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([stageId, status])
  @@map("tasks")
}

model Estimate {
  id          String   @id @default(cuid())
  stageId     String
  itemName    String
  unit        String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  stage   Stage             @relation(fields: [stageId], references: [id], onDelete: Cascade)
  history EstimateHistory[]

  @@index([stageId])
  @@map("estimate_items")
}

// Snapshot of every change made to an estimate line, for audit history.
// estimateId is nullable and SetNull-on-delete so a "deleted" history row
// (which already carries a full field snapshot) survives the item's removal.
model EstimateHistory {
  id          String   @id @default(cuid())
  estimateId  String?
  stageId     String
  changedById String
  itemName    String
  unit        String
  quantity    Float
  unitPrice   Float
  totalPrice  Float
  action      String // "created" | "updated" | "deleted"
  changedAt   DateTime @default(now())

  estimate  Estimate? @relation(fields: [estimateId], references: [id], onDelete: SetNull)
  changedBy User      @relation(fields: [changedById], references: [id], onDelete: Cascade)

  @@index([estimateId, changedAt])
  @@index([stageId, changedAt])
  @@map("estimate_history")
}

// Acceptance checklist item for a stage (sign-off before moving on)
model ChecklistItem {
  id        String   @id @default(cuid())
  stageId   String
  text      String
  checked   Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())

  stage Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("checklist_items")
}

// Finger-drawn signature captured on the acceptance checklist
model Signature {
  id        String   @id @default(cuid())
  stageId   String
  signerId  String?
  signerName String
  imageData String   @db.Text // base64 PNG data URL
  createdAt DateTime @default(now())

  stage  Stage @relation(fields: [stageId], references: [id], onDelete: Cascade)
  signer User? @relation(fields: [signerId], references: [id], onDelete: SetNull)

  @@map("signatures")
}

// A scheduled crew site visit, shown on the project calendar
model Visit {
  id        String   @id @default(cuid())
  projectId String
  stageId   String?
  date      DateTime
  crewName  String?
  note      String?
  createdAt DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId, date])
  @@map("visits")
}


// ---------------------------------------------------------------------------
// Field operations: shifts, daily logs, change orders, defects, materials, docs
// ---------------------------------------------------------------------------

// A crew member's working shift, optionally geo-stamped at start and finish,
// so hours can be totalled for payroll.
model Shift {
  id        String    @id @default(cuid())
  projectId String
  stageId   String?
  userId    String
  startedAt DateTime  @default(now())
  endedAt   DateTime?
  startLat  Float?
  startLng  Float?
  endLat    Float?
  endLng    Float?
  note      String?
  createdAt DateTime  @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId, startedAt])
  @@index([userId, endedAt])
  @@map("shifts")
}

// One structured record per site day — weather, headcount, what got done.
// Unlike the chat, this is a report that can be handed to a customer.
model DailyLog {
  id          String   @id @default(cuid())
  projectId   String
  date        DateTime @db.Date
  weather     String?
  temperature Int?
  crewCount   Int?
  workDone    String
  issues      String?
  authorId    String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  author  User    @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@unique([projectId, date])
  @@index([projectId, date])
  @@map("daily_logs")
}

// Extra work agreed mid-project. Keeping it a signed record instead of a chat
// message is what stops "we never agreed to that" disputes at handover.
model ChangeOrder {
  id            String            @id @default(cuid())
  projectId     String
  stageId       String?
  number        Int
  title         String
  description   String?
  amount        Float
  status        ChangeOrderStatus @default(PENDING)
  createdById   String
  decidedById   String?
  decidedAt     DateTime?
  // Customer's finger signature captured on approval.
  signatureData String?           @db.Text
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdBy User    @relation("ChangeOrderAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  decidedBy User?   @relation("ChangeOrderDecider", fields: [decidedById], references: [id], onDelete: SetNull)

  @@unique([projectId, number])
  @@index([projectId, status])
  @@map("change_orders")
}

// Snag / punch list: defects found at handover, assigned and verified.
model PunchItem {
  id          String      @id @default(cuid())
  projectId   String
  stageId     String?
  title       String
  description String?
  assigneeId  String?
  photoId     String?
  status      PunchStatus @default(OPEN)
  dueDate     DateTime?
  createdById String
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage     Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)
  assignee  User?   @relation("PunchAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy User    @relation("PunchAuthor", fields: [createdById], references: [id], onDelete: Cascade)
  photo     Photo?  @relation(fields: [photoId], references: [id], onDelete: SetNull)

  @@index([projectId, status])
  @@map("punch_items")
}

// Materials planned vs actually consumed on the object.
model Material {
  id               String   @id @default(cuid())
  projectId        String
  stageId          String?
  name             String
  unit             String
  quantityPlanned  Float    @default(0)
  quantityUsed     Float    @default(0)
  unitPrice        Float    @default(0)
  supplier         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  stage   Stage?  @relation(fields: [stageId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@map("materials")
}

// Contracts, PDF drawings, certificates — anything that isn't a site photo.
model Document {
  id           String           @id @default(cuid())
  projectId    String
  name         String
  url          String
  mimeType     String
  sizeBytes    Int
  category     DocumentCategory @default(OTHER)
  uploadedById String
  createdAt    DateTime         @default(now())

  project    Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation(fields: [uploadedById], references: [id], onDelete: Cascade)

  @@index([projectId, category])
  @@map("documents")
}
