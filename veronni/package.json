{
  "name": "veronni-agent",
  "version": "1.0.0",
  "private": true,
  "description": "ИИ-агент пиццерии Veronni: принимает заказы в Telegram обычным текстом",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "chat": "tsx src/cli.ts",
    "seed": "tsx prisma/seed.ts",
    "db:push": "prisma db push",
    "setup": "prisma db push && tsx prisma/seed.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.117.1",
    "@prisma/client": "^5.19.1",
    "grammy": "^1.45.1"
  },
  "devDependencies": {
    "@types/node": "^20.14.15",
    "prisma": "^5.19.1",
    "tsx": "^4.16.5",
    "typescript": "^5.5.4",
    "vitest": "^4.1.10"
  }
}
